    "@prisma/client": "^7.8.0",
    "@upstash/redis": "^1.38.1",
    "ai": "^7.0.31",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
